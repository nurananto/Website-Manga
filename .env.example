# API worker (login, koin, unlock, chapter-token)
VITE_WORKER_URL=https://manga-worker.xxx.workers.dev

# Image worker (chapter terkunci via token + cover) — domain "images."
# Jika kosong, akan fallback ke VITE_WORKER_URL (salah untuk gambar).
VITE_IMAGE_URL=https://images.nuranantoscans.my.id

# CDN publik R2 (chapter GRATIS dilayani langsung dari sini — lebih murah & cache edge).
# WAJIB diisi; jika kosong, chapter gratis ikut lewat image worker (images.) — boros & tanpa fallback CDN.
VITE_CDN_URL=https://cdn.nuranantoscans.my.id
