{
  "name": "website-manga",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"const fs=require('fs');fs.writeFileSync('public/version.json',JSON.stringify({v:Date.now().toString(),label:new Date().toLocaleDateString('id'),type:'code'}))\" && npm run sitemap && vite build && node scripts/inline-css.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.js",
    "check:locked": "node scripts/check-locked-leak.js",
    "check:unlock": "node scripts/check-unlock-migration.js"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.9",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
