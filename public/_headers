# Hashed assets (JS/CSS dengan nama hash) — cache 1 tahun
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Catalog JSON — cache 5 menit (diupdate oleh GitHub Action)
/manga/index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=60

/manga/*.json
  Cache-Control: public, max-age=300, stale-while-revalidate=60

# HTML — tidak di-cache agar deploy terbaru langsung aktif
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Service worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
