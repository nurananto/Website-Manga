# Hashed assets (JS/CSS dengan nama hash) — cache 1 tahun
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Catalog JSON — selalu fresh agar views langsung tampil setelah deploy
/manga/index.json
  Cache-Control: no-cache

/manga/*.json
  Cache-Control: no-cache

# HTML — tidak di-cache agar deploy terbaru langsung aktif
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Service worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
